{
  "name": "roboarm-web-visualizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.config.lib.ts",
    "build:app": "vite build",
    "build:lib": "vite build --config vite.config.lib.ts",
    "test": "vitest run",
    "serve": "vite preview --host 0.0.0.0 --port 8080"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.30.2",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/three": "^0.179.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
